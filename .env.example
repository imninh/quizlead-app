# Key AI dùng chung. Điền ở .env.local hoặc biến môi trường Vercel — KHÔNG commit key thật.
AI_API_KEY=
# Tên cũ vẫn được đọc nếu AI_API_KEY trống:
# OPENROUTER_API_KEY=
# OPENCODE_API_KEY=

# Mặc định: OpenRouter + anthropic/claude-haiku-5.5 (soạn quiz rồi tự soát lại)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-haiku-5.5
AI_GHOST_MODEL=qwen/qwen3.5-flash-02-23
# Model dự phòng, cách nhau dấu phẩy (để trống nếu không dùng)
AI_FALLBACK_MODELS=google/gemini-2.5-flash-lite
# Lượt AI tự soát câu hỏi sau khi soạn (mặc định bật; đặt off để tắt). AI_REVIEW_MODEL để trống = dùng model soạn.
# AI_REVIEW=off
# AI_REVIEW_MODEL=
AI_RATE_LIMIT_PER_MIN=5
# Khi có Upstash: giới hạn AI dùng chung mọi instance (mặc định generate 5/phút, ghost 3/phút)
# AI_GHOST_RATE_LIMIT_PER_MIN=3
# Trần chung toàn site mỗi ngày theo giờ Việt Nam (mặc định generate 150, ghost 100)
# AI_DAILY_LIMIT=150
# AI_GHOST_DAILY_LIMIT=100
APP_URL=http://localhost:5173
# Dùng khi build production để og:image là URL tuyệt đối (Facebook preview).
# VITE_APP_URL=https://quizlead-abc.vercel.app

# Xếp hạng online — KHÔNG điền giá trị thật vào file này.
# Bật bằng Upstash; nếu thiếu, app chạy offline như cũ.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace có thể đặt tên KV_*; code đọc cả hai bộ (ưu tiên UPSTASH_*).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Chuỗi ký token, tối thiểu 32 ký tự.
ONLINE_SECRET=
# Passcode thao tác online, tối thiểu 8 ký tự.
ADMIN_PASSCODE=
# Chỉ dùng ở máy dev/test: kho trong bộ nhớ.
# ONLINE_DEV_MEMORY=1
# ONLINE_RATE_LIMIT_PER_MIN=30
